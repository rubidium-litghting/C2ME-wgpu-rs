{
  "schemaVersion": 1,
  "id": "c2me-opts-accel-wgpu",
  "version": "${version}",
  "name": "C2ME-wgpu-rs",
  "description": "GPU-accelerated world generation using wgpu (Vulkan/Metal/DX12/WebGPU). Requires C2ME.",
  "authors": [
    "RubidiumLighting"
  ],
  "contact": {
    "homepage": "https://gitee.com/rubidium-lighting/C2ME-wgpu-rs",
    "sources": "https://gitee.com/rubidium-lighting/C2ME-wgpu-rs",
    "issues": "https://gitee.com/rubidium-lighting/C2ME-wgpu-rs/issues"
  },
  "license": "MIT",
  "icon": "assets/c2me-opts-accel-wgpu/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.rubidiumlighting.c2me.opts.accel.wgpu.WgpuModInitializer"
    ],
    "modmenu": [
      "com.rubidiumlighting.c2me.opts.accel.wgpu.client.WgpuModMenuApi"
    ]
  },
  "mixins": [
    "c2me-opts-accel-wgpu.mixins.json"
  ],
  "depends": {
    "minecraft": "~1.21.1",
    "fabricloader": ">=0.17.2",
    "java": ">=25",
    "c2me": "*"
  },
  "accessWidener": "c2me-opts-accel-wgpu.accesswidener",
  "suggests": {
    "modmenu": "*"
  }
}
